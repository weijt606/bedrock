# --- facts (required) ---------------------------------------------------
CALA_API_KEY=

# --- reasoning engine: plans lookups, reshapes rows, reads labels --------
OPENAI_API_KEY=
MODEL_PLANNER=gpt-4o-mini
MODEL_VISION=gpt-4o-mini

# --- fine-tuned specialist: classifies and scores registry rows ---------
# Key: https://app.pioneer.ai/api-keys   (sent as X-API-Key, not a bearer token)
PIONEER_API_KEY=
PIONEER_BASE=https://api.pioneer.ai
# A GLiNER2 encoder out of the box; swap in your own job id (job_...) once
# `python scripts/train_assay.py train` has finished.
MODEL_ASSAY=fastino/gliner2-base-v1
ASSAY_THRESHOLD=0.5
ASSAY_TIMEOUT_S=12
# Post corrections back so Pioneer retrains on our live traffic.
PIONEER_ADAPTIVE=1

# --- speech to text, and cut-outs for the shelf -------------------------
FAL_KEY=266f09bf-22b9-41b2-9b74-9e8de37bd2f6:74b3c4311b6354bb81f16f5a4086f422
FAL_STT_MODEL=fal-ai/whisper

# --- speed budget (Cala is 16-75s cold, ~0.5s warm) ---------------------
PROBE_TIMEOUT_S=90
TOTAL_BUDGET_S=150
MAX_CONCURRENT_PROBES=4
CACHE_DIR=.cache
CORS_ORIGINS=http://localhost:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://localhost:8000
